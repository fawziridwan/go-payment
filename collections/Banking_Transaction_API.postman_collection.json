		{
			"name": "HMAC Signature (Optional)",
			"item": [
				{
					"name": "Request With Signature",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// HMAC Signature calculation",
									"// Signature = HMAC_SHA256(secretKey, METHOD + PATH + BODY + TIMESTAMP)",
									"",
									"var timestamp = Math.floor(Date.now() / 1000).toString();",
									"var method = 'GET';",
									"var path = '/v1/accounts/' + pm.collectionVariables.get('source_account_id') + '/balance';",
									"var body = '';",
									"",
									"var message = method + path + body + timestamp;",
									"",
									"// Use your HMAC secret key (JWT_SECRET_KEY as fallback)",
									"var secretKey = '8acec2cc4727abce77202b2746ea9f2a04db60ca889d81ed07c34c1e65c61a81';",
									"",
									"var signature = CryptoJS.HmacSHA256(message, secretKey).toString(CryptoJS.enc.Hex);",
									"",
									"pm.variables.set('x_timestamp', timestamp);",
									"pm.variables.set('x_signature', signature);",
									"",
									"console.log('Timestamp: ' + timestamp);",
									"console.log('Message: ' + message);",
									"console.log('Signature: ' + signature);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-Key",
								"value": "{{api_key}}"
							},
							{
								"key": "X-Signature",
								"value": "{{x_signature}}",
								"description": "Auto-calculated HMAC SHA256 signature"
							},
							{
								"key": "X-Timestamp",
								"value": "{{x_timestamp}}",
								"description": "Auto-calculated unix timestamp"
							}
						],
						"url": {
							"raw": "{{base_url}}/v1/accounts/{{source_account_id}}/balance",
							"host": ["{{base_url}}"],
							"path": ["v1", "accounts", "{{source_account_id}}", "balance"]
						},
						"description": "Test request with HMAC SHA256 signature.\n\nThe pre-request script automatically calculates:\n- `X-Timestamp`: Current unix timestamp\n- `X-Signature`: HMAC_SHA256(secretKey, METHOD + PATH + BODY + TIMESTAMP)\n\n⚠️ Update the `secretKey` in the pre-request script to match your `HMAC_SECRET_KEY` or `JWT_SECRET_KEY`."
					},
					"response": []
				},
				{
					"name": "Request With Invalid Signature - Should Fail",
					"event": [
						{
							"listen": "test",
